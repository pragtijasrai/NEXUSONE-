# ═══════════════════════════════════════════════════════════
# NexusOne Frontend — Environment Variables
#
# Copy this file to .env and fill in your values.
# For production, set these in your hosting platform's dashboard
# (Render, Netlify, Vercel, etc.) — never commit .env.
# ═══════════════════════════════════════════════════════════

# Backend API base URL (no trailing slash)
# Development:
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Production (replace with your actual Render backend URL):
# VITE_API_BASE_URL=https://nexusone-backend.onrender.com/api/v1

# Set to 'false' to use real backend, 'true' for mock mode (dev only)
VITE_USE_MOCK=false
