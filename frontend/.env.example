# ═══════════════════════════════════════════════════════════
# NexusOne Frontend — Environment Variables
#
# Copy this file to .env and fill in values.
# NEVER put secrets here — these are exposed to the browser.
# ═══════════════════════════════════════════════════════════

# Backend API base URL
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Set to false to use the real backend instead of mock data
# true  → uses localStorage mock users (no backend needed)
# false → calls the real Express + PostgreSQL backend
VITE_USE_MOCK=true
