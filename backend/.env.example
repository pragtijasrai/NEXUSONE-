# ═══════════════════════════════════════════════════════════
# NexusOne Backend — Environment Variables
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# In production, set these in your hosting platform's dashboard.
# ═══════════════════════════════════════════════════════════

# ── Server ──
NODE_ENV=development
PORT=4000

# Comma-separated list of allowed frontend origins
# Development:
CORS_ORIGIN=http://localhost:5173
# Production (replace with your actual frontend URL):
# CORS_ORIGIN=https://nexusone.onrender.com

# ── PostgreSQL ──
# Format: postgres://username:password@host:port/database
# Development:
DATABASE_URL=postgres://nexusone:your_password@localhost:5432/nexusone
# Production (Render/Railway provide this automatically):
# DATABASE_URL=postgresql://user:pass@host.render.com/nexusone

# ── JWT ──
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be at least 32 characters. Use a different value in production.
JWT_SECRET=replace_with_a_long_random_string_min_32_chars
JWT_EXPIRES_IN=1h

# ── Frontend URL (used for password reset links) ──
# Development:
FRONTEND_URL=http://localhost:5173
# Production:
# FRONTEND_URL=https://nexusone.onrender.com

# ── Email (SMTP) ──
# Leave blank to disable email sending (password reset shows token in dev mode).
# Gmail: enable "App Passwords" and use the app password below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="NexusOne Campus <no-reply@chitkara.edu.in>"

# ── AI Assistant ──
# Google Gemini API key — get one at https://makersuite.google.com/app/apikey
# Leave blank to use enhanced canned responses instead.
GEMINI_API_KEY=

# ── Logging ──
# Options: fatal, error, warn, info, debug, trace
LOG_LEVEL=info
